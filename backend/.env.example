# Copy this file to backend/.env and fill in your key. Never commit .env.
GEMINI_API_KEY=replace_with_your_key

# Fast default. List what your key can use with:
#   python -c "from google import genai; [print(m.name) for m in genai.Client().models.list()]"
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the primary model is overloaded (503) or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# minimal | low | medium | high. Lower = faster. If a model rejects a level,
# the backend steps up automatically (minimal -> low -> off).
GEMINI_THINKING_LEVEL=minimal
GEMINI_TEMPERATURE=0.6
GEMINI_MAX_OUTPUT_TOKENS=700

# Comma-separated list of allowed browser origins. Empty = any Chrome
# extension. Find your id on chrome://extensions, e.g.
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=

REQUEST_TIMEOUT_S=30
RATE_LIMIT_PER_MIN=20
HEDGE_AFTER_S=4
